# DeepCrawl environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=deepcrawl123

# AI / LLM (OpenAI-compatible API, required)
AI_BASEURL=https://api.deepseek.com
AI_APIKEY=your-key
AI_MODEL=deepseek-v4-flash

# Zhipu (智谱) — search provider (default) + web reader fetch tier
ZHIPU_APIKEY=your-zhipu-key-here
# Search provider: Zhipu (default) | Bocha
SEARCH_PROVIDER=Zhipu
